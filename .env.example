# Django Core Configuration
SECRET_KEY=django-insecure-change-me-for-production-environment-secret-key-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Set USE_SQLITE=True to run with SQLite db.sqlite3)
USE_SQLITE=True

# PostgreSQL Configuration (used when USE_SQLITE=False)
DB_NAME=construction_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email Backend (Console in dev, SMTP in prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Resend Email API
RESEND_API_KEY=
RESEND_FROM_EMAIL=BuildSphere <onboarding@resend.dev>

# JWT Lifetimes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Media Uploads
MEDIA_ROOT=./media
MAX_UPLOAD_MB=5

# Localization
TIME_ZONE=Asia/Kolkata

# Demo Seed Password
SEED_PASSWORD=ChangeMe#12345
